{
  "name": "safeeat-scanner-sdk-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "safeeat-scanner-sdk-workspace",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@safeeat/scanner-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@safeeat/scanner-web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/core": {
      "name": "@safeeat/scanner-core",
      "version": "0.0.0",
      "license": "Apache-2.0"
    },
    "packages/web": {
      "name": "@safeeat/scanner-web",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@safeeat/scanner-core": "*"
      }
    }
  }
}
